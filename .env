# ─────────────────────────────────────────────────────────────────────────────
# .env -- Variables de configuration ClimaCity Paris
#
# Ce fichier est chargé automatiquement par docker compose.
# Modifiez les valeurs selon votre machine et vos préférences.
# Ne commitez pas ce fichier dans Git si vous changez le token Jupyter.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports (modifiez si un port est déjà occupé sur votre machine) ─────────────
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
MLFLOW_PORT=5000

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Token d'accès à JupyterLab.
# URL d'accès : http://localhost:8888/lab?token=climacity
JUPYTER_TOKEN=climacity

# ── Versions des outils ───────────────────────────────────────────────────────
MLFLOW_VERSION=2.17.2

# ── Ressources Docker ─────────────────────────────────────────────────────────
# Mémoire allouée au conteneur Jupyter (inclut la JVM Spark).
# Règle : au moins 1,5× la valeur de SPARK_DRIVER_MEMORY.
#
# Machine 8  Go RAM  →  DOCKER_MEMORY_LIMIT=6g   SPARK_DRIVER_MEMORY=4g
# Machine 16 Go RAM  →  DOCKER_MEMORY_LIMIT=10g  SPARK_DRIVER_MEMORY=7g
# Machine 32 Go RAM  →  DOCKER_MEMORY_LIMIT=20g  SPARK_DRIVER_MEMORY=14g
DOCKER_MEMORY_LIMIT=9g
DOCKER_CPU_LIMIT=8
SPARK_DRIVER_MEMORY=6g
